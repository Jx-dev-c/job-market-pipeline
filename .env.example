# Copie para .env e preencha os valores reais. NUNCA commite o .env real.

# --- Adzuna API (https://developer.adzuna.com/) ---
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=br

# --- Jooble API (opcional, ainda não usado) ---
JOOBLE_API_KEY=

# --- GCP (pra quando migrar, ver docs/migrar_para_gcp.md) ---
GCP_PROJECT_ID=
GCP_LOCATION=US
GOOGLE_APPLICATION_CREDENTIALS=/opt/airflow/keys/sa-key.json
GCS_RAW_BUCKET=
BQ_RAW_DATASET=raw_job_market
BQ_STAGING_DATASET=job_market_staging
BQ_INTERMEDIATE_DATASET=job_market_intermediate
BQ_MARTS_DATASET=job_market_marts

# --- Postgres local (dev do dbt + metadata do Airflow) ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_AIRFLOW_DB=airflow
POSTGRES_AIRFLOW_USER=airflow
POSTGRES_AIRFLOW_PASSWORD=airflow_local_pw
POSTGRES_JOB_MARKET_DB=job_market
POSTGRES_JOB_MARKET_USER=job_market
POSTGRES_JOB_MARKET_PASSWORD=job_market_local_pw
POSTGRES_DSN=postgresql://job_market:job_market_local_pw@postgres:5432/job_market

# --- Airflow ---
AIRFLOW_UID=50000
# Encripta senhas de conexão guardadas pelo Airflow. Gere a sua com:
#   python3 -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
AIRFLOW_FERNET_KEY=
